config_version=5

[application]

config/name="ЦВЕТМЕТ"
config/description="Кооператив про охотников за цветметом на ночной свалке"
config/version="0.0.1"
run/main_scene="res://scenes/game/garage.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
Settings="*res://scripts/autoload/settings.gd"
Save="*res://scripts/autoload/save.gd"
Game="*res://scripts/autoload/game.gd"
Net="*res://scripts/autoload/net.gd"
Voice="*res://scripts/autoload/voice.gd"
Audio="*res://scripts/autoload/audio.gd"
DebugMenu="*res://scenes/debug/debug_menu.gd"
Shot="*res://scripts/debug/screenshot_tool.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/cvetmet_pipeline/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.ru.translation", "res://locale/strings.en.translation")
locale/fallback="ru"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=1
